{
  "name": "@korchasa/flowai-workflow",
  "version": "0.12.3",
  "license": "MIT",
  "exports": {
    ".": "./src/cli.ts",
    "./engine": "./src/mod.ts"
  },
  "imports": {
    "@korchasa/ai-ide-cli": "jsr:@korchasa/ai-ide-cli@^0.8.13",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/yaml": "jsr:@std/yaml@^1.2.0",
    "@std/semver": "jsr:@std/semver@^1.0.8",
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@^1.30.0",
    "zod": "npm:zod@^4.4.3"
  },
  "tasks": {
    "check": "deno run -A scripts/check.ts",
    "test": "deno test -A --no-check --ignore=.claude/worktrees,.flowai-workflow/*/runs",
    "run": "deno run -A --no-check src/cli.ts run .flowai-workflow/github-inbox",
    "loop": "deno run -A --no-check scripts/self-runner.ts",
    "dashboard": "deno run --allow-read --allow-write scripts/generate-dashboard.ts",
    "workflow-diagram": "deno run --allow-read --allow-write scripts/workflow-diagram.ts",
    "compile": "deno run -A scripts/compile.ts",
    "release": "deno run -A npm:commit-and-tag-version@13.1.2 --skip.tag",
    "fmt": "deno fmt",
    "sync-plugins": "deno run -A scripts/sync-plugins-repo.ts",
    "sync-plugins-local": "deno run -A scripts/sync-plugins-local.ts"
  },
  "fmt": {
    "proseWrap": "preserve",
    "exclude": [
      "**/*.md",
      ".*/**/*.md"
    ]
  },
  "lint": {
    "exclude": [
      ".claude/worktrees/",
      ".flowai-workflow/*/agents/"
    ]
  },
  "publish": {
    "include": [
      "./",
      "./deno.json",
      "./README.md"
    ],
    "exclude": [
      "**/*_test.ts",
      ".claude/**",
      ".devcontainer/**",
      ".flowai-workflow/*/runs/**",
      ".flowai-workflow/*/memory/agent-*.md",
      ".flowai-workflow/.template.json",
      ".flowai-workflow/*/.template.json",
      ".github/**",
      "plugin-src",
      "src/testing",
      "dist/**",
      "documents/**",
      "scripts/**",
      "**/AGENTS.md",
      "**/CLAUDE.md",
      "CHANGELOG.md",
      ".versionrc.json",
      ".gitignore",
      ".gitattributes",
      "deno.lock"
    ]
  }
}
